# Zmienne frontu. Na VPS trzymamy je w `/opt/marinero-frontend/.env.local`.
# Prawdziwego `.env` nie commitujemy — patrz `.gitignore`.
#
# WAŻNE: część stron jest prerenderowana w czasie builda, więc plik musi
# istnieć PRZED budowaniem. Po zmianie wartości: `bash /root/marinero-deploy.sh --force`.

# Directus (domyślnie publiczny adres produkcyjny)
DIRECTUS_URL=https://dms.marinero.150197.pl

# Medusa — Store API sklepu
NEXT_PUBLIC_MEDUSA_URL=https://commerce.marinero.150197.pl
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Klucz Admin API Medusy (sk_...). Potrzebny TYLKO narzędziom w /admin
# (opisy produktów). Nigdy nie trafia do przeglądarki. Medusa 2 uwierzytelnia
# go przez HTTP Basic — nagłówek x-medusa-access-token zwraca 401.
MEDUSA_ADMIN_TOKEN=

# Czat na stronie (Chatwoot). Bez tych dwóch widżet się nie ładuje.
# Adres instancji i `websiteToken` skrzynki „Website" z panelu Chatwoota.
CHATWOOT_URL=
CHATWOOT_TOKEN=

# Google. Puste = strona nie odpytuje Google i nie zapisuje ciasteczek.
GA_ID=
GOOGLE_ADS_ID=
GOOGLE_SITE_VERIFICATION=

# Adres kanoniczny — używany m.in. w feedzie do Merchant Center.
NEXT_PUBLIC_SITE_URL=https://marinero.150197.pl

# Poczta wychodząca (oferty z konfiguratora, potwierdzenia zamówień)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Sól do liczenia unikalnych wejść. Odcisk to skrót z adresu IP i przeglądarki,
# solony i zmieniany co dobę — bez soli dałoby się go odtworzyć, zgadując adresy.
# Dowolny długi losowy ciąg, np. `openssl rand -hex 32`.
STATYSTYKI_SOL=

# Obsługa zamówień
ORDERS_API_TOKEN=
APACZKA_APP_ID=
APACZKA_APP_SECRET=
# Identyfikatory usług z `service_structure` (patrz scripts/apaczka/uslugi.mjs).
# Trzy różne, bo trzy różne przesyłki: paczka pod adres, paczkomat i paleta —
# kurierzy paczkowi kończą na 31,5 kg, a nasz cennik sięga 340 kg.
APACZKA_SERVICE_ID=21
APACZKA_SERVICE_ID_PACZKOMAT=41
APACZKA_SERVICE_ID_PALETA=140

# Kanały sprzedaży
CHANNEL_SYNC_TOKEN=
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REFRESH_TOKEN=

# PayU — płatności online w sklepie (karta, BLIK, szybki przelew).
# Bez kompletu tych zmiennych opcja płatności online w ogóle się nie pokazuje,
# a sklep działa jak dotąd: przelew / ustalenie po zamówieniu.
# Dane z panelu PayU: Moje sklepy → punkt płatności (POS).
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
# „Drugi klucz (MD5)" — nim PayU podpisuje powiadomienia o płatności.
PAYU_MD5_KEY=
# `sandbox` = środowisko testowe PayU. Puste albo cokolwiek innego = produkcja.
PAYU_ENV=sandbox
