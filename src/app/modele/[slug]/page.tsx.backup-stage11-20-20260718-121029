            <p className="mt-3 text-sm leading-6 text-[#111827]/55">
              Oferta będzie mogła zawierać model, silnik, wyposażenie, ceny i dane klienta.
            </p>
          </div>
        </section>
      </section>

      <Footer />
    </main>
  )
