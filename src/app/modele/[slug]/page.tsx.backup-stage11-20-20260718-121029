export const revalidate = 60

type ModelPageProps = {
  params: Promise<{
    slug: string
  }>
}

function cleanHtml(value: string | null | undefined) {
  if (!value) return ""

  let cleaned = value
    .replace(/<script[\s\S]*?<\/script>/gi, " ")
    .replace(/<style[\s\S]*?<\/style>/gi, " ")
    .replace(/<noscript[\s\S]*?<\/noscript>/gi, " ")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim()

  cleaned = cleaned
    .replace(/var galleryId[\s\S]*$/i, "")
    .replace(/Poznaj pozostałe modele[\s\S]*$/i, "")
    .replace(/@font-face[\s\S]*$/i, "")
    .replace(/#pt-cv-view[\s\S]*$/i, "")
    .replace(/\s+/g, " ")
    .trim()

  return cleaned
}

function formatPrice(price: number | string | null | undefined, currency?: string) {
  if (!price) return ""

  const value = Number(price)

  if (!Number.isFinite(value)) return ""

  return new Intl.NumberFormat("pl-PL", {
    style: "currency",
    currency: currency || "EUR",
    maximumFractionDigits: 0,
  }).format(value)
}

function isImageUrl(url: string) {
  return /\.(jpg|jpeg|png|webp)(\?.*)?$/i.test(url)
}

function unique(values: string[]) {
  return Array.from(new Set(values.filter(Boolean)))
}

function normalizeOldUrl(url: string) {
  return url
    .replace("https://www.marinero.pl", "https://marinero.pl")
    .replace(/&amp;/g, "&")
    .replace(/&#x27;/g, "")
    .trim()
}

function extractGalleryJsonUrls(value: string | null | undefined) {
  if (!value) return []

  const urls = value.match(
    /https?:\/\/(?:www\.)?marinero\.pl\/wp-content\/uploads\/[^"'\\s<>]+?\.json/gi
  )

  return unique((urls || []).map(normalizeOldUrl)).filter((url) =>
    /gallery|galeria/i.test(url)
  )
}

function extractInlineImageUrls(value: string | null | undefined, slug: string) {
  if (!value) return []

  const beforeRelatedModels = value.split(/Poznaj pozostałe modele/i)[0] || value

  const urls = beforeRelatedModels.match(
    /https?:\/\/(?:www\.)?marinero\.pl\/wp-content\/uploads\/[^"'\\s<>]+?\.(?:jpg|jpeg|png|webp)(?:\?[^"'\\s<>]*)?/gi
  )

  const modelHints = slug
    .replace(/^jeanneau-/, "")
    .replace(/^aquila-/, "")
    .replace(/^nordkapp-/, "")
    .replace(/^xo-/, "")
    .replace(/^sting-/, "")
    .split("-")
    .filter(Boolean)

  return unique((urls || []).map(normalizeOldUrl)).filter((url) => {
    if (!isImageUrl(url)) return false
    if (/font|logo|icon|placeholder|sprite/i.test(url)) return false

    const lower = url.toLowerCase()

    if (modelHints.length >= 2) {
      const hitCount = modelHints.filter((hint) => lower.includes(hint)).length
      if (hitCount >= 1) return true
    }

    return /gallery|galeria|scaled|jpg|jpeg|png|webp/i.test(lower)
  })
}

async function getOldGalleryUrls(model: any) {
  const source = [model.description, model.old_site_raw_text].filter(Boolean).join(" ")
  const jsonUrls = extractGalleryJsonUrls(source)
  const fromJson: string[] = []

  for (const jsonUrl of jsonUrls.slice(0, 2)) {
    try {
      const res = await fetch(jsonUrl, {
        next: {
          revalidate: 3600,
        },
      })

      if (!res.ok) continue

      const data = await res.json()

      if (Array.isArray(data)) {
        for (const item of data) {
          if (typeof item === "string" && isImageUrl(item)) {
            fromJson.push(normalizeOldUrl(item))
          }

          if (item && typeof item === "object") {
            const possible =
              item.url ||
              item.src ||
              item.image ||
              item.full ||
              item.full_url ||
              item.source_url

            if (typeof possible === "string" && isImageUrl(possible)) {
              fromJson.push(normalizeOldUrl(possible))
            }
          }
        }
      }
    } catch {
      // pomijamy błędny JSON ze starej strony
    }
  }

  // Priorytet: prawdziwy plik JSON galerii.
  // Fallback z opisu tylko wtedy, gdy JSON nie ma zdjęć.
  const fallback = extractInlineImageUrls(source, model.slug)

  const urls = fromJson.length > 0 ? fromJson : fallback

  return unique(urls).filter((url) => {
    if (!isImageUrl(url)) return false
    if (/font|Regular\.ttf|Bold\.ttf|Italic\.ttf|logo|icon/i.test(url)) return false
    return true
  })
}

function SpecItem({
  label,
  value,
}: {
  label: string
  value?: string | number | null
}) {
  if (!value) return null

  return (
    <div className="rounded-[0.8rem] border border-[#111827]/10 bg-[#f6f5f2] p-4">
      <p className="text-sm font-medium text-[#111827]/45">
        {label}
      </p>
      <p className="mt-2 font-semibold">{value}</p>
    </div>
  )
}

export default async function ModelPage({ params }: ModelPageProps) {
