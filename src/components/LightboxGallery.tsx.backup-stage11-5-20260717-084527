"use client"

import { useEffect, useMemo, useState } from "react"

type LightboxGalleryProps = {
  modelName: string
  urls: string[]
}

export default function LightboxGallery({ modelName, urls }: LightboxGalleryProps) {
  const cleanUrls = useMemo(() => {
    return Array.from(new Set((urls || []).filter(Boolean)))
  }, [urls])

  const [openIndex, setOpenIndex] = useState<number | null>(null)
  const [showAll, setShowAll] = useState(false)
  const [touchStartX, setTouchStartX] = useState<number | null>(null)

  const visibleUrls = showAll ? cleanUrls : cleanUrls.slice(0, 3)
  const hasMore = cleanUrls.length > 3

  function close() {
    setOpenIndex(null)
  }

  function previous() {
    if (openIndex === null || cleanUrls.length === 0) return
    setOpenIndex((openIndex - 1 + cleanUrls.length) % cleanUrls.length)
  }

  function next() {
    if (openIndex === null || cleanUrls.length === 0) return
    setOpenIndex((openIndex + 1) % cleanUrls.length)
  }

  useEffect(() => {
    if (openIndex === null) return

    function onKeyDown(event: KeyboardEvent) {
      if (event.key === "Escape") close()
      if (event.key === "ArrowLeft") previous()
      if (event.key === "ArrowRight") next()
    }

    document.body.style.overflow = "hidden"
    window.addEventListener("keydown", onKeyDown)

    return () => {
      document.body.style.overflow = ""
      window.removeEventListener("keydown", onKeyDown)
    }
  }, [openIndex, cleanUrls.length])

  if (cleanUrls.length === 0) return null

  const activeSrc = openIndex !== null ? cleanUrls[openIndex] : ""

  return (
    <section className="mt-10 rounded-[1.25rem] bg-white p-8 shadow-sm md:p-10">
      <div className="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p className="mb-2 text-xs font-semibold uppercase tracking-[0.28em] text-[#111827]/40">
            Galeria
          </p>
          <h2 className="text-2xl font-semibold tracking-tight md:text-4xl">
            Zdjęcia modelu
          </h2>
        </div>

        <p className="text-sm text-[#111827]/45">
          {showAll ? cleanUrls.length : Math.min(3, cleanUrls.length)} z {cleanUrls.length} zdjęć
        </p>
      </div>

      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {visibleUrls.map((src, index) => (
          <button
            key={`${src}-${index}`}
            type="button"
            onClick={() => setOpenIndex(index)}
            className="group overflow-hidden rounded-[1rem] bg-[#ddd7ca] text-left"
            aria-label={`Otwórz zdjęcie ${index + 1}`}
          >
            <img
              src={src}
              alt={`${modelName} — zdjęcie ${index + 1}`}
              className="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              loading={index > 2 ? "lazy" : "eager"}
            />
          </button>
        ))}
      </div>

      {hasMore ? (
        <div className="mt-8">
          <button
            type="button"
            onClick={() => setShowAll((value) => !value)}
            className="inline-flex rounded-md bg-[#2E64A8] px-5 py-3 text-sm font-bold text-white"
          >
            {showAll ? "Pokaż mniej zdjęć" : "Zobacz więcej zdjęć"}
          </button>
        </div>
      ) : null}

      {openIndex !== null ? (
        <div
          className="fixed inset-0 z-[9999] flex items-center justify-center bg-black/95 px-4 py-6"
          role="dialog"
          aria-modal="true"
          onClick={close}
          onTouchStart={(event) => {
            setTouchStartX(event.touches[0]?.clientX ?? null)
          }}
          onTouchEnd={(event) => {
            if (touchStartX === null) return

            const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX
            const diff = touchStartX - touchEndX

            if (Math.abs(diff) > 45) {
              if (diff > 0) next()
              else previous()
            }

            setTouchStartX(null)
          }}
        >
          <button
            type="button"
            onClick={(event) => {
              event.stopPropagation()
              close()
            }}
            className="absolute right-4 top-4 z-20 rounded-full bg-white/10 px-4 py-2 text-sm font-bold text-white backdrop-blur transition hover:bg-white/20"
            aria-label="Zamknij galerię"
          >
            Zamknij
          </button>

          {cleanUrls.length > 1 ? (
            <>
              <button
                type="button"
                onClick={(event) => {
                  event.stopPropagation()
                  previous()
                }}
                className="absolute left-3 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-3xl text-white backdrop-blur transition hover:bg-white/20 md:left-8 md:h-14 md:w-14"
                aria-label="Poprzednie zdjęcie"
              >
                ‹
              </button>

              <button
                type="button"
                onClick={(event) => {
                  event.stopPropagation()
                  next()
                }}
                className="absolute right-3 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-3xl text-white backdrop-blur transition hover:bg-white/20 md:right-8 md:h-14 md:w-14"
                aria-label="Następne zdjęcie"
              >
                ›
              </button>
            </>
          ) : null}

          <div
            className="flex h-full max-h-[92vh] w-full max-w-[1500px] flex-col items-center justify-center gap-4"
            onClick={(event) => event.stopPropagation()}
          >
            <img
              src={activeSrc}
              alt={`${modelName} — zdjęcie ${openIndex + 1}`}
              className="max-h-[82vh] max-w-full select-none rounded-lg object-contain"
              draggable={false}
            />

            <div className="rounded-full bg-white/10 px-4 py-2 text-xs font-semibold text-white/80 backdrop-blur">
              {openIndex + 1} / {cleanUrls.length}
            </div>
          </div>
        </div>
      ) : null}
    </section>
  )
}
