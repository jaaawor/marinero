"use client"

import { useMemo, useState } from "react"

type Option = {
  id: string
  name: string
  price: number
  category: string
}

type Engine = {
  id: string
  name: string
  price: number
}

type BoatConfiguratorProps = {
  modelName: string
  slug: string
  brandName?: string
}

const engines: Engine[] = [
  {
    id: "standard",
    name: "Napęd standardowy / do ustalenia",
    price: 0,
  },
  {
    id: "outboard-2x400",
    name: "2 × Mercury Verado 400",
    price: 0,
  },
  {
    id: "inboard-diesel",
    name: "Napęd stacjonarny diesel",
    price: 0,
  },
]

const options: Option[] = [
  {
    id: "generator",
    category: "Komfort",
    name: "Generator",
    price: 0,
  },
  {
    id: "air-conditioning",
    category: "Komfort",
    name: "Klimatyzacja",
    price: 0,
  },
  {
    id: "bow-thruster",
    category: "Manewrowanie",
    name: "Ster strumieniowy dziobowy",
    price: 0,
  },
  {
    id: "joystick",
    category: "Manewrowanie",
    name: "Joystick / system manewrowania",
    price: 0,
  },
  {
    id: "premium-audio",
    category: "Multimedia",
    name: "System audio premium",
    price: 0,
  },
  {
    id: "teak",
    category: "Wykończenie",
    name: "Pokład teak / syntetyczny teak",
    price: 0,
  },
  {
    id: "navigation",
    category: "Elektronika",
    name: "Pakiet elektroniki nawigacyjnej",
    price: 0,
  },
  {
    id: "underwater-lights",
    category: "Wykończenie",
    name: "Oświetlenie podwodne",
    price: 0,
  },
]

function formatPrice(value: number) {
  if (!value) return "do wyceny"

  return new Intl.NumberFormat("pl-PL", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  }).format(value)
}

export default function BoatConfigurator({
  modelName,
  slug,
  brandName,
}: BoatConfiguratorProps) {
  const [selectedEngine, setSelectedEngine] = useState(engines[0].id)
  const [selectedOptions, setSelectedOptions] = useState<string[]>([])
  const [clientName, setClientName] = useState("")
  const [clientEmail, setClientEmail] = useState("")
  const [clientPhone, setClientPhone] = useState("")
  const [notes, setNotes] = useState("")

  const selectedEngineData = engines.find((engine) => engine.id === selectedEngine) || engines[0]

  const selectedOptionData = useMemo(() => {
    return options.filter((option) => selectedOptions.includes(option.id))
  }, [selectedOptions])

  const totalKnownPrice = useMemo(() => {
    return selectedEngineData.price + selectedOptionData.reduce((sum, option) => sum + option.price, 0)
  }, [selectedEngineData, selectedOptionData])

  const groupedOptions = useMemo(() => {
    return options.reduce<Record<string, Option[]>>((acc, option) => {
      acc[option.category] ||= []
      acc[option.category].push(option)
      return acc
    }, {})
  }, [])

  function toggleOption(id: string) {
    setSelectedOptions((current) => {
      if (current.includes(id)) {
        return current.filter((item) => item !== id)
      }

      return [...current, id]
    })
  }

  const summaryText = [
    `Model: ${modelName}`,
    brandName ? `Marka: ${brandName}` : "",
    `Slug: ${slug}`,
    `Napęd: ${selectedEngineData.name}`,
    selectedOptionData.length
      ? `Wyposażenie: ${selectedOptionData.map((option) => option.name).join(", ")}`
      : "Wyposażenie: brak wybranych opcji",
    clientName ? `Klient: ${clientName}` : "",
    clientEmail ? `E-mail: ${clientEmail}` : "",
    clientPhone ? `Telefon: ${clientPhone}` : "",
    notes ? `Uwagi: ${notes}` : "",
  ]
    .filter(Boolean)
    .join("\\n")

  const mailto = `mailto:biuro@marinero.pl?subject=${encodeURIComponent(
    `Konfiguracja ${modelName}`
  )}&body=${encodeURIComponent(summaryText)}`

  return (
    <div className="grid gap-6 lg:grid-cols-[1fr_420px]">
      <div className="space-y-6">
        <section className="rounded-[1.25rem] bg-white p-6 shadow-sm md:p-8">
          <p className="mb-2 text-xs font-semibold tracking-[0.18em] text-[#111827]/40">
            Krok 1
          </p>
          <h2 className="text-2xl font-semibold tracking-tight">
            Wybierz napęd
          </h2>

          <div className="mt-6 grid gap-3">
            {engines.map((engine) => (
              <label
                key={engine.id}
                className={`cursor-pointer rounded-[1rem] border p-4 transition ${
                  selectedEngine === engine.id
                    ? "border-[#2E64A8] bg-[#2E64A8]/5"
                    : "border-[#111827]/10 bg-white hover:border-[#2E64A8]/40"
                }`}
              >
                <div className="flex gap-3">
                  <input
                    type="radio"
                    name="engine"
                    checked={selectedEngine === engine.id}
                    onChange={() => setSelectedEngine(engine.id)}
                    className="mt-1"
                  />
                  <div>
                    <p className="font-semibold">{engine.name}</p>
                    <p className="mt-1 text-sm text-[#111827]/50">
                      {formatPrice(engine.price)}
                    </p>
                  </div>
                </div>
              </label>
            ))}
          </div>
        </section>

        <section className="rounded-[1.25rem] bg-white p-6 shadow-sm md:p-8">
          <p className="mb-2 text-xs font-semibold tracking-[0.18em] text-[#111827]/40">
            Krok 2
          </p>
          <h2 className="text-2xl font-semibold tracking-tight">
            Wybierz wyposażenie
          </h2>

          <div className="mt-6 space-y-6">
            {Object.entries(groupedOptions).map(([category, items]) => (
              <div key={category}>
                <h3 className="mb-3 text-sm font-semibold text-[#111827]/55">
                  {category}
                </h3>

                <div className="grid gap-3 md:grid-cols-2">
                  {items.map((option) => (
                    <label
                      key={option.id}
                      className={`cursor-pointer rounded-[1rem] border p-4 transition ${
                        selectedOptions.includes(option.id)
                          ? "border-[#2E64A8] bg-[#2E64A8]/5"
                          : "border-[#111827]/10 bg-white hover:border-[#2E64A8]/40"
                      }`}
                    >
                      <div className="flex gap-3">
                        <input
                          type="checkbox"
                          checked={selectedOptions.includes(option.id)}
                          onChange={() => toggleOption(option.id)}
                          className="mt-1"
                        />
                        <div>
                          <p className="font-semibold">{option.name}</p>
                          <p className="mt-1 text-sm text-[#111827]/50">
                            {formatPrice(option.price)}
                          </p>
                        </div>
                      </div>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section className="rounded-[1.25rem] bg-white p-6 shadow-sm md:p-8">
          <p className="mb-2 text-xs font-semibold tracking-[0.18em] text-[#111827]/40">
            Krok 3
          </p>
          <h2 className="text-2xl font-semibold tracking-tight">
            Dane do oferty
          </h2>

          <div className="mt-6 grid gap-4 md:grid-cols-2">
            <input
              value={clientName}
              onChange={(event) => setClientName(event.target.value)}
              placeholder="Imię i nazwisko"
              className="rounded-md border border-[#111827]/15 px-4 py-3 outline-none focus:border-[#2E64A8]"
            />

            <input
              value={clientEmail}
              onChange={(event) => setClientEmail(event.target.value)}
              placeholder="Adres e-mail"
              className="rounded-md border border-[#111827]/15 px-4 py-3 outline-none focus:border-[#2E64A8]"
            />

            <input
              value={clientPhone}
              onChange={(event) => setClientPhone(event.target.value)}
              placeholder="Telefon"
              className="rounded-md border border-[#111827]/15 px-4 py-3 outline-none focus:border-[#2E64A8]"
            />

            <input
              value={notes}
              onChange={(event) => setNotes(event.target.value)}
              placeholder="Uwagi, termin zakupu, miejsce użytkowania"
              className="rounded-md border border-[#111827]/15 px-4 py-3 outline-none focus:border-[#2E64A8]"
            />
          </div>
        </section>
      </div>

      <aside className="h-fit rounded-[1.25rem] bg-white p-6 shadow-sm md:p-8 lg:sticky lg:top-6">
        <p className="mb-2 text-xs font-semibold tracking-[0.18em] text-[#111827]/40">
          Podsumowanie
        </p>

        <h2 className="text-2xl font-semibold tracking-tight">
          {modelName}
        </h2>

        {brandName ? (
          <p className="mt-2 text-sm text-[#111827]/45">{brandName}</p>
        ) : null}

        <div className="mt-6 space-y-4 text-sm">
          <div className="rounded-[1rem] bg-[#f6f5f2] p-4">
            <p className="text-[#111827]/45">Napęd</p>
            <p className="mt-1 font-semibold">{selectedEngineData.name}</p>
          </div>

          <div className="rounded-[1rem] bg-[#f6f5f2] p-4">
            <p className="text-[#111827]/45">Wybrane opcje</p>
            {selectedOptionData.length ? (
              <ul className="mt-2 space-y-1">
                {selectedOptionData.map((option) => (
                  <li key={option.id}>• {option.name}</li>
                ))}
              </ul>
            ) : (
              <p className="mt-1 font-semibold">Brak wybranych opcji</p>
            )}
          </div>

          <div className="rounded-[1rem] bg-[#f6f5f2] p-4">
            <p className="text-[#111827]/45">Wartość znanych pozycji</p>
            <p className="mt-1 text-2xl font-semibold">
              {formatPrice(totalKnownPrice)}
            </p>
            <p className="mt-2 text-xs leading-5 text-[#111827]/45">
              Ceny wyposażenia uzupełnimy z konfiguratora Marinero / cennika.
              Obecnie konfigurator przygotowuje zakres oferty.
            </p>
          </div>
        </div>

        <a
          href={mailto}
          className="mt-6 inline-flex w-full justify-center rounded-md bg-[#2E64A8] px-5 py-3 text-sm font-bold text-white"
        >
          Przygotuj zapytanie ofertowe
        </a>

        <p className="mt-4 text-xs leading-5 text-[#111827]/40">
          W kolejnym etapie podepniemy generowanie oferty PDF lub zapis konfiguracji
          do Directusa.
        </p>
      </aside>
    </div>
  )
}
