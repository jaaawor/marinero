# Skopiuj do `.env` obok `docker-compose.yml` i uzupełnij.
# `.env` NIE trafia do repozytorium — trzyma hasła.
#
# UWAGA: tego pliku nie wolno wczytywać przez `source` / `. .env`.
# Wartości takie jak `Marinero <biuro@marinero.pl>` powłoka potraktuje jako
# przekierowanie i wywali błąd składni. Docker Compose czyta plik sam.

# Port na pętli zwrotnej, pod którym nginx szuka Chatwoota.
# Skrypt instalacyjny sam wybiera wolny, jeśli to pole jest puste.
CHATWOOT_PORT=

# Adres, pod którym stoi Chatwoot (musi się zgadzać z certyfikatem w nginx).
FRONTEND_URL=https://chat.marinero.150197.pl
FORCE_SSL=true
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Wygeneruj raz: openssl rand -hex 64
SECRET_KEY_BASE=

# Baza i kolejka — te same hasła co w docker-compose.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=
REDIS_URL=redis://:HASLO_REDIS@redis:6379
REDIS_PASSWORD=

# Rejestracja z ulicy wyłączona — konta zakłada administrator.
ENABLE_ACCOUNT_SIGNUP=false

# Poczta wychodząca (powiadomienia o nowej rozmowie, zaproszenia dla zespołu).
# Do uzupełnienia razem z SMTP dla reszty serwisu, po przeniesieniu na marinero.pl.
MAILER_SENDER_EMAIL=Marinero <biuro@marinero.pl>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Załączniki trzymamy na dysku serwera (kopia w /opt/backups jak reszta).
ACTIVE_STORAGE_SERVICE=local
